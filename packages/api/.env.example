PORT=3001
DATABASE_URL=postgres://rural_help:rural_help_dev@localhost:5432/rural_help

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production

# Never set this in production. It returns the password reset code in the
# forgot-password response instead of emailing it, which would let anyone who
# knows an email address take over that account.
EXPOSE_RESET_CODE=false

# Production: required to keep the unreviewed clinical content off the open
# internet. Visitors get a browser username/password prompt before the site or
# API loads. Username defaults to "ruralhelp" via SITE_BASIC_AUTH_USER.
SITE_BASIC_AUTH_PASSWORD=

# Production: browser origins allowed to call the API, comma separated.
# Leave empty to accept same-origin only, which is the normal setup where the
# API serves the web app from its own domain.
ALLOWED_ORIGINS=